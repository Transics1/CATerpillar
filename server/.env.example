# Copy to server/.env and fill in.

# MongoDB Atlas M0 connection string (free tier).
# Atlas > Connect > Drivers > copy. Remember to append the database name.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/catcopilot?retryWrites=true&w=majority

JWT_SECRET=change-me-any-random-string
PORT=5000

# FastAPI ML service. If unreachable, /api/predict/task-time falls back to a heuristic
# returning the identical response shape.
ML_SERVICE_URL=http://localhost:8000

# P2 only - the LLM enhancement layer. Server-side only, never exposed to the client bundle.
GROQ_API_KEY=
GEMINI_API_KEY=
